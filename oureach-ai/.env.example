# Copy this file to .env before running the app

# Port the server runs on
PORT=3000

# Session secret - change this to any random string before deploying
SESSION_SECRET=change-this-to-a-long-random-string

# Demo mode:
#   true  -> Instagram/Facebook/Twitter/LinkedIn sends are SIMULATED so the app
#            works immediately for a demo/viva without needing approved developer
#            apps on each platform.
#   false -> the app will attempt real API calls using the keys below. You must
#            register developer apps with each platform and get them approved
#            for posting/messaging before this will work.
DEMO_MODE=true

# --- Real platform API credentials (only needed when DEMO_MODE=false) ---
# Instagram / Facebook (Meta for Developers - Graph API)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# Twitter / X (developer.twitter.com - API v2)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# LinkedIn (developer.linkedin.com)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
